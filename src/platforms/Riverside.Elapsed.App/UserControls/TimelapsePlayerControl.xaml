<UserControl
	x:Class="Riverside.Elapsed.App.UserControls.TimelapsePlayerControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel Spacing="14">
		<!-- cinematic 16:9-ish player. black bezel, big rounded corners. -->
		<Border Background="#000000" CornerRadius="{ThemeResource ElapsedRadiusThumbnail}">
			<MediaPlayerElement
				MinHeight="420"
				AreTransportControlsEnabled="True"
				AutoPlay="False"
				Source="{Binding PlaybackUrl}" />
		</Border>
		<TextBlock
			FontSize="24"
			FontWeight="SemiBold"
			Foreground="{ThemeResource ElapsedTextPrimary}"
			Text="{Binding Title}"
			TextWrapping="WrapWholeWords" />
		<TextBlock
			FontSize="13"
			Foreground="{ThemeResource ElapsedTextMuted}"
			Text="{Binding Subtitle}"
			TextWrapping="WrapWholeWords" />
	</StackPanel>
</UserControl>
