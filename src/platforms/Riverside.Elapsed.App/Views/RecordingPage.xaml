<Page
	x:Class="Riverside.Elapsed.App.Views.RecordingPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				x:Name="ControlsColumn"
				Width="*"
				MinWidth="320" />
			<ColumnDefinition x:Name="PreviewColumn" Width="0" />
		</Grid.ColumnDefinitions>

		<!-- Setup / controls panel (always visible) -->
		<Border
			Grid.Column="0"
			Padding="20"
			Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
			<Grid>
				<!-- Setup state -->
				<Grid Visibility="{Binding IsInSetup, Converter={StaticResource BoolToVisibilityConverter}}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- Header: brand + profile -->
					<Grid Grid.Row="0" Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel
							Grid.Column="0"
							VerticalAlignment="Center"
							Orientation="Horizontal"
							Spacing="8">
							<Image
								Width="28"
								Height="28"
								Source="ms-appx:///Assets/Icons/iconLogo.targetsize-256.png" />
							<TextBlock
								VerticalAlignment="Center"
								FontSize="18"
								FontWeight="SemiBold"
								Text="Elapsed" />
						</StackPanel>

						<!-- Profile picture -->
						<PersonPicture
							x:Name="ProfilePersonPicture"
							Grid.Column="1"
							Width="32"
							Height="32"
							DisplayName="{Binding UserDisplayName}"
							IsEnabled="{Binding IsSignedIn}"
							ProfilePicture="{Binding UserProfilePicture}"
							Tapped="ProfilePersonPicture_Tapped">
							<FlyoutBase.AttachedFlyout>
								<MenuFlyout Placement="BottomEdgeAlignedRight">
									<MenuFlyoutItem IsEnabled="False" Text="{Binding UserDisplayName}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Command="{Binding ViewProfileCommand}" Text="View Profile">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE77B;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem Command="{Binding SignOutCommand}" Text="Sign Out">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE7E8;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
								</MenuFlyout>
							</FlyoutBase.AttachedFlyout>
						</PersonPicture>
					</Grid>

					<!-- Source kind toggle: Screen / Window / Camera -->
					<Grid
						Grid.Row="1"
						Height="36"
						Margin="0,0,0,12"
						Background="{ThemeResource ControlFillColorSecondaryBrush}"
						CornerRadius="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<RadioButton
							x:Name="ScreenRadio"
							Grid.Column="0"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Screen"
							GroupName="SourceKind"
							IsChecked="True"
							Style="{StaticResource SegmentedToggleStyle}" />
						<RadioButton
							x:Name="WindowRadio"
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Window"
							GroupName="SourceKind"
							Style="{StaticResource SegmentedToggleStyle}" />
						<RadioButton
							x:Name="CameraRadio"
							Grid.Column="2"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Camera"
							GroupName="SourceKind"
							Style="{StaticResource SegmentedToggleStyle}" />
					</Grid>

					<!-- Source grid -->
					<ScrollViewer
						x:Name="SourceScrollViewer"
						Grid.Row="2"
						Margin="0,0,0,16"
						SizeChanged="OnSourceScrollViewerSizeChanged">
						<ItemsRepeater ItemsSource="{Binding CurrentSources}">
							<ItemsRepeater.Layout>
								<UniformGridLayout
									x:Name="SourceGridLayout"
									MinColumnSpacing="6"
									MinItemHeight="148"
									MinItemWidth="158"
									MinRowSpacing="6" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<Border
										Background="{ThemeResource ControlFillColorDefaultBrush}"
										BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
										BorderThickness="1"
										CornerRadius="8"
										PointerPressed="OnSourceCardPressed">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="3*" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>
											<Border
												Grid.Row="0"
												Background="{ThemeResource ControlFillColorTertiaryBrush}"
												CornerRadius="7,7,0,0">
												<Image
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Source="{Binding Thumbnail}"
													Stretch="UniformToFill" />
											</Border>
											<StackPanel
												Grid.Row="1"
												Padding="8,6,8,6"
												Spacing="1">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<Image
														Width="14"
														Height="14"
														VerticalAlignment="Center"
														Source="{Binding Icon}"
														Visibility="{Binding Icon, Converter={StaticResource NullToCollapsedConverter}}" />
													<TextBlock
														FontSize="11"
														FontWeight="Bold"
														MaxLines="1"
														Text="{Binding Name}"
														TextTrimming="CharacterEllipsis" />
												</StackPanel>
												<TextBlock
													FontSize="10"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													MaxLines="1"
													Text="{Binding Description}"
													TextTrimming="CharacterEllipsis"
													Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}" />
												<TextBlock
													FontSize="10"
													Foreground="{ThemeResource TextFillColorTertiaryBrush}"
													Text="{Binding Resolution}"
													Visibility="{Binding Resolution, Converter={StaticResource NullToCollapsedConverter}}" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</ScrollViewer>

					<!-- Sign in prompt (shown when not authenticated) -->
					<Border
						Grid.Row="3"
						Margin="0,0,0,8"
						Padding="12"
						Background="{ThemeResource ControlFillColorSecondaryBrush}"
						CornerRadius="8"
						Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
						<StackPanel HorizontalAlignment="Center" Spacing="8">
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="Sign in to your Lapse account to start recording timelapses."
								TextAlignment="Center"
								TextWrapping="Wrap" />
							<Button
								HorizontalAlignment="Center"
								Command="{Binding SignInCommand}"
								Style="{ThemeResource AccentButtonStyle}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<FontIcon FontSize="14" Glyph="&#xE77B;" />
									<TextBlock
										VerticalAlignment="Center"
										FontSize="12"
										Text="Sign In" />
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Start recording button -->
					<Button
						Grid.Row="4"
						Height="44"
						HorizontalAlignment="Stretch"
						Command="{Binding StartRecordingCommand}"
						CornerRadius="22"
						Style="{ThemeResource AccentButtonStyle}"
						Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon FontSize="14" Glyph="&#xE7C8;" />
							<TextBlock
								VerticalAlignment="Center"
								FontSize="14"
								FontWeight="SemiBold"
								Text="Start Recording" />
						</StackPanel>
					</Button>
				</Grid>

				<!-- Active recording state -->
				<StackPanel
					VerticalAlignment="Center"
					Spacing="16"
					Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">

					<!-- Recording indicator -->
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="8">
						<Ellipse
							Width="10"
							Height="10"
							VerticalAlignment="Center"
							Fill="Red" />
						<TextBlock
							VerticalAlignment="Center"
							FontSize="14"
							FontWeight="SemiBold"
							Text="{Binding IsPaused, Converter={StaticResource BoolToPausedRecordingLabelConverter}}" />
					</StackPanel>

					<!-- Elapsed time -->
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="48"
						FontWeight="SemiBold"
						Text="{Binding ElapsedDisplay}" />

					<!-- Controls -->
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="12">
						<Button
							Width="48"
							Height="48"
							Padding="0"
							Command="{Binding PauseResumeCommand}"
							CornerRadius="24"
							ToolTipService.ToolTip="{Binding PauseResumeLabel}">
							<FontIcon FontSize="18" Glyph="{Binding PauseResumeGlyph}" />
						</Button>
						<Button
							Width="48"
							Height="48"
							Padding="0"
							Command="{Binding StopCommand}"
							CornerRadius="24"
							Style="{ThemeResource AccentButtonStyle}"
							ToolTipService.ToolTip="Stop recording">
							<FontIcon FontSize="16" Glyph="&#xE71A;" />
						</Button>
					</StackPanel>

					<!-- Status -->
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="12"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Text="{Binding StatusMessage}"
						TextWrapping="Wrap"
						Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
				</StackPanel>

				<!-- Encoding state -->
				<StackPanel
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center"
					Spacing="16"
					Visibility="{Binding IsEncoding, Converter={StaticResource BoolToVisibilityConverter}}">

					<FontIcon
						HorizontalAlignment="Center"
						FontSize="32"
						Glyph="&#xE714;" />

					<TextBlock
						HorizontalAlignment="Center"
						FontSize="18"
						FontWeight="SemiBold"
						Text="Encoding Video" />

					<ProgressBar
						Margin="40,0"
						HorizontalAlignment="Stretch"
						IsIndeterminate="True" />

					<TextBlock
						HorizontalAlignment="Center"
						FontSize="12"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Text="Preparing your timelapse..." />
				</StackPanel>

				<!-- Uploading state -->
				<StackPanel
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center"
					Spacing="16"
					Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibilityConverter}}">

					<FontIcon
						HorizontalAlignment="Center"
						FontSize="32"
						Glyph="&#xE898;" />

					<TextBlock
						HorizontalAlignment="Center"
						FontSize="18"
						FontWeight="SemiBold"
						Text="Uploading to Lapse" />

					<ProgressBar
						Margin="40,0"
						HorizontalAlignment="Stretch"
						Maximum="1"
						Value="{Binding UploadProgress}" />

					<TextBlock
						HorizontalAlignment="Center"
						FontSize="12"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Text="{Binding UploadStatusText}"
						TextWrapping="Wrap" />

					<!-- Error status -->
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="12"
						Foreground="Red"
						Text="{Binding StatusMessage}"
						TextWrapping="Wrap"
						Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
				</StackPanel>

				<!-- Publishing state: title, description, visibility form -->
				<Grid
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center"
					Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVisibilityConverter}}">
					<StackPanel Margin="20,0" Spacing="16">
						<FontIcon
							HorizontalAlignment="Center"
							FontSize="28"
							Glyph="&#xE70F;" />

						<TextBlock
							HorizontalAlignment="Center"
							FontSize="18"
							FontWeight="SemiBold"
							Text="Publish Timelapse" />

						<TextBox
							Header="Title"
							MaxLength="60"
							PlaceholderText="Give your timelapse a name"
							Text="{Binding PublishTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBox
							Height="80"
							AcceptsReturn="True"
							Header="Description"
							MaxLength="280"
							PlaceholderText="What were you working on?"
							Text="{Binding PublishDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="Wrap" />

						<ComboBox
							HorizontalAlignment="Stretch"
							Header="Visibility"
							ItemsSource="{Binding VisibilityOptions}"
							SelectedIndex="{Binding PublishVisibilityIndex, Mode=TwoWay}" />

						<Button
							Height="40"
							HorizontalAlignment="Stretch"
							Command="{Binding PublishCommand}"
							CornerRadius="20"
							Style="{ThemeResource AccentButtonStyle}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="14" Glyph="&#xE898;" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="14"
									FontWeight="SemiBold"
									Text="Publish" />
							</StackPanel>
						</Button>

						<!-- Status text during publish -->
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{Binding UploadStatusText}"
							TextWrapping="Wrap"
							Visibility="{Binding UploadStatusText, Converter={StaticResource NullToCollapsedConverter}}" />

						<!-- Error status -->
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Foreground="Red"
							Text="{Binding StatusMessage}"
							TextWrapping="Wrap"
							Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
					</StackPanel>
				</Grid>
			</Grid>
		</Border>

		<!-- Preview panel (visible only during recording) -->
		<Border
			Grid.Column="1"
			MinWidth="300"
			Background="{ThemeResource ControlFillColorSecondaryBrush}"
			BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
			BorderThickness="1,0,0,0"
			Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid>
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}"
					Text="No preview available"
					Visibility="{Binding PreviewImage, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}" />
				<Image
					Margin="16"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Source="{Binding PreviewImage}"
					Stretch="Uniform" />
			</Grid>
		</Border>
	</Grid>
</Page>
