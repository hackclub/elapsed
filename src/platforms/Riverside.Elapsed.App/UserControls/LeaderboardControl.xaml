<UserControl
	x:Class="Riverside.Elapsed.App.UserControls.LeaderboardControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border
		x:Name="LeaderboardRoot"
		Style="{StaticResource ElapsedCard}">
		<StackPanel Spacing="22">

			<!-- header: small cool-orpheus illustration + title + subtitle -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Image
					Width="60"
					Height="60"
					VerticalAlignment="Center"
					Source="ms-appx:///Assets/Illustrations/orpheus-cool.png" />
				<StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="3">
					<TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="Leaderboard" />
					<TextBlock
						FontSize="13"
						Foreground="{ThemeResource ElapsedTextMuted}"
						Text="These Hack Clubbers spent the most time documenting their work this week." />
				</StackPanel>
			</Grid>

			<!-- horizontal scroller of avatar tiles. ranked, with subtle ranking pip on each avatar. -->
			<ScrollViewer
				HorizontalScrollMode="Enabled"
				HorizontalScrollBarVisibility="Auto"
				VerticalScrollBarVisibility="Disabled">
				<ItemsRepeater ItemsSource="{Binding LeaderboardEntries}">
					<ItemsRepeater.Layout>
						<StackLayout Orientation="Horizontal" Spacing="28" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Button
								Padding="6"
								Background="Transparent"
								BorderThickness="0"
								CornerRadius="12"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								Command="{Binding DataContext.OpenProfileCommand, ElementName=LeaderboardRoot}"
								CommandParameter="{Binding}">
								<StackPanel Width="128" Spacing="10">
									<Ellipse Width="96" Height="96" HorizontalAlignment="Center" Stroke="{ThemeResource ElapsedStroke}" StrokeThickness="1">
										<Ellipse.Fill>
											<ImageBrush ImageSource="{Binding ProfilePictureUrl}" Stretch="UniformToFill" />
										</Ellipse.Fill>
									</Ellipse>
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="16"
										FontWeight="SemiBold"
										Foreground="{ThemeResource ElapsedTextPrimary}"
										Text="{Binding Name}"
										TextAlignment="Center"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="12"
										Foreground="{ThemeResource ElapsedTextMuted}"
										LineHeight="16"
										Text="{Binding WeeklyText}"
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</StackPanel>
	</Border>
</UserControl>
