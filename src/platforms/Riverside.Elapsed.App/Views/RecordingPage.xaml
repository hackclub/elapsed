<Page
	x:Class="Riverside.Elapsed.App.Views.RecordingPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<!-- Setup / controls panel (always visible) -->
		<Border
			Grid.Column="0"
			Width="380"
			Padding="20"
			Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
			<Grid>
				<!-- Setup state -->
				<Grid Visibility="{Binding IsInSetup, Converter={StaticResource BoolToVisibilityConverter}}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- Header: brand + settings -->
					<Grid Grid.Row="0" Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel
							Grid.Column="0"
							Orientation="Horizontal"
							Spacing="8"
							VerticalAlignment="Center">
							<Ellipse
								Width="28"
								Height="28"
								Stroke="{ThemeResource AccentFillColorDefaultBrush}"
								StrokeThickness="3" />
							<TextBlock
								FontSize="18"
								FontWeight="SemiBold"
								VerticalAlignment="Center"
								Text="Elapsed" />
						</StackPanel>
						<Button
							Grid.Column="1"
							Width="32"
							Height="32"
							Padding="0"
							Background="Transparent"
							BorderThickness="0"
							ToolTipService.ToolTip="Settings">
							<FontIcon FontSize="16" Glyph="&#xE713;" />
						</Button>
					</Grid>

					<!-- Source kind toggle: Screen / Window / Camera -->
					<Grid
						Grid.Row="1"
						Height="36"
						Margin="0,0,0,12"
						Background="{ThemeResource ControlFillColorSecondaryBrush}"
						CornerRadius="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<RadioButton
							x:Name="ScreenRadio"
							Grid.Column="0"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Screen"
							GroupName="SourceKind"
							IsChecked="True"
							Style="{StaticResource SegmentedToggleStyle}" />
						<RadioButton
							x:Name="WindowRadio"
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Window"
							GroupName="SourceKind"
							Style="{StaticResource SegmentedToggleStyle}" />
						<RadioButton
							x:Name="CameraRadio"
							Grid.Column="2"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Camera"
							GroupName="SourceKind"
							Style="{StaticResource SegmentedToggleStyle}" />
					</Grid>

					<!-- Source grid -->
					<ScrollViewer Grid.Row="2" Margin="0,0,0,16">
						<ItemsRepeater ItemsSource="{Binding CurrentSources}">
							<ItemsRepeater.Layout>
								<UniformGridLayout
									MinItemWidth="158"
									MinItemHeight="148"
									MinColumnSpacing="6"
									MinRowSpacing="6" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<Border
										CornerRadius="8"
										Background="{ThemeResource ControlFillColorDefaultBrush}"
										BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
										BorderThickness="1"
										PointerPressed="OnSourceCardPressed">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="88" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>
											<Border
												Grid.Row="0"
												CornerRadius="7,7,0,0"
												Background="{ThemeResource ControlFillColorTertiaryBrush}">
												<Image
													Source="{Binding Thumbnail}"
													Stretch="UniformToFill"
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
											<StackPanel Grid.Row="1" Padding="8,6,8,6" Spacing="1">
												<TextBlock
													FontSize="11"
													FontWeight="Bold"
													MaxLines="1"
													Text="{Binding Name}"
													TextTrimming="CharacterEllipsis" />
												<TextBlock
													FontSize="10"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													MaxLines="1"
													Text="{Binding Description}"
													TextTrimming="CharacterEllipsis"
													Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}" />
												<TextBlock
													FontSize="10"
													Foreground="{ThemeResource TextFillColorTertiaryBrush}"
													Text="{Binding Resolution}"
													Visibility="{Binding Resolution, Converter={StaticResource NullToCollapsedConverter}}" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</ScrollViewer>

					<!-- Start recording button -->
					<Button
						Grid.Row="3"
						Height="44"
						HorizontalAlignment="Stretch"
						Command="{Binding StartRecordingCommand}"
						CornerRadius="22"
						Style="{ThemeResource AccentButtonStyle}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon FontSize="14" Glyph="&#xE7C8;" />
							<TextBlock
								FontSize="14"
								FontWeight="SemiBold"
								Text="Start Recording"
								VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</Grid>

				<!-- Active recording state -->
				<StackPanel
					Spacing="16"
					VerticalAlignment="Center"
					Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">

					<!-- Recording indicator -->
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="8">
						<Ellipse
							Width="10"
							Height="10"
							VerticalAlignment="Center"
							Fill="Red" />
						<TextBlock
							FontSize="14"
							FontWeight="SemiBold"
							VerticalAlignment="Center"
							Text="{Binding IsPaused, Converter={StaticResource BoolToPausedRecordingLabelConverter}}" />
					</StackPanel>

					<!-- Elapsed time -->
					<TextBlock
						FontSize="48"
						FontWeight="SemiBold"
						HorizontalAlignment="Center"
						Text="{Binding ElapsedDisplay}" />

					<!-- Controls -->
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="12">
						<Button
							Width="48"
							Height="48"
							Padding="0"
							Command="{Binding PauseResumeCommand}"
							CornerRadius="24"
							ToolTipService.ToolTip="{Binding PauseResumeLabel}">
							<FontIcon FontSize="18" Glyph="{Binding PauseResumeGlyph}" />
						</Button>
						<Button
							Width="48"
							Height="48"
							Padding="0"
							Command="{Binding StopCommand}"
							CornerRadius="24"
							Style="{ThemeResource AccentButtonStyle}"
							ToolTipService.ToolTip="Stop recording">
							<FontIcon FontSize="16" Glyph="&#xE71A;" />
						</Button>
					</StackPanel>

					<!-- Status -->
					<TextBlock
						FontSize="12"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						HorizontalAlignment="Center"
						Text="{Binding StatusMessage}"
						TextWrapping="Wrap"
						Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
				</StackPanel>
			</Grid>
		</Border>

		<!-- Preview panel (visible only during recording) -->
		<Border
			Grid.Column="1"
			Width="460"
			Background="{ThemeResource ControlFillColorSecondaryBrush}"
			BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
			BorderThickness="1,0,0,0"
			Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid>
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}"
					Text="No preview available" />
				<Image
					Source="{Binding PreviewImage}"
					Stretch="Uniform"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="16" />
			</Grid>
		</Border>
	</Grid>
</Page>
