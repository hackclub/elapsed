<Page
	x:Class="Riverside.Elapsed.App.Views.MainPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Riverside.Elapsed.App.UserControls"
	xmlns:utu="using:Uno.Toolkit.UI"
	NavigationCacheMode="Required">
	<Grid utu:SafeArea.Insets="VisibleBounds" Background="{ThemeResource ElapsedPageBackground}">
		<ScrollViewer
			x:Name="MainRoot"
			HorizontalScrollMode="Disabled"
			VerticalScrollBarVisibility="Auto">
			<!-- centred content column. wider gutters and breathing room than before. -->
			<Grid HorizontalAlignment="Stretch" Padding="32,28,32,28">
				<StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Spacing="24">

					<!-- welcome banner (signed out only). detective orpheus on the left, big greeting,
					     hack-club-red sign-in cta on the right. flush, borderless, big illustration. -->
					<Grid
						Padding="4,8,4,16"
						Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Image
							Width="112"
							Height="112"
							VerticalAlignment="Center"
							Source="ms-appx:///Assets/Illustrations/orpheus-time.png" />

						<StackPanel
							Grid.Column="1"
							Margin="28,0,28,0"
							VerticalAlignment="Center"
							Spacing="6">
							<TextBlock
								FontSize="28"
								FontWeight="SemiBold"
								LineHeight="34"
								Foreground="{ThemeResource ElapsedTextPrimary}"
								Text="{Binding GreetingTitle}"
								TextWrapping="WrapWholeWords" />
							<TextBlock
								FontSize="14"
								Foreground="{ThemeResource ElapsedTextMuted}"
								Text="{Binding GreetingSubtitle}"
								TextWrapping="WrapWholeWords" />
						</StackPanel>

						<Button
							Grid.Column="2"
							VerticalAlignment="Center"
							Style="{StaticResource ElapsedAccentButton}"
							Command="{Binding SignInCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<FontIcon
									FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
									FontSize="14"
									Foreground="White"
									Glyph="&#xE77B;" />
								<TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" Text="Sign in with Lapse" VerticalAlignment="Center" />
							</StackPanel>
						</Button>
					</Grid>

					<!-- divider beneath the welcome banner -->
					<Border
						Height="1"
						Background="{ThemeResource ElapsedDivider}"
						Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

					<controls:LeaderboardControl />
					<controls:ExploreTimelapsesControl />

					<!-- footer credit pill -->
					<Border
						Margin="0,12,0,8"
						HorizontalAlignment="Center"
						Style="{StaticResource ElapsedPill}">
						<TextBlock
							FontSize="12"
							Foreground="{ThemeResource ElapsedTextMuted}"
							Text="{Binding FooterText}"
							TextAlignment="Center" />
					</Border>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</Page>
