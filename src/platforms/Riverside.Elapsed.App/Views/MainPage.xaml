<Page
	x:Class="Riverside.Elapsed.App.Views.MainPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Riverside.Elapsed.App.UserControls"
	xmlns:utu="using:Uno.Toolkit.UI"
	xmlns:converters="using:Riverside.Elapsed.App.Converters"
	NavigationCacheMode="Required">
	<Grid utu:SafeArea.Insets="VisibleBounds" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ScrollViewer x:Name="MainRoot" HorizontalScrollMode="Disabled" Padding="24,16,24,24">
			<StackPanel Spacing="20">
				<!-- welcome banner (shown only when not authenticated; mock 1/2) -->
				<Border
					Padding="20"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="12"
					Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Image
							Width="96"
							Height="96"
							VerticalAlignment="Center"
							Source="ms-appx:///Assets/Illustrations/orpheus-cool.png" />

						<StackPanel
							Grid.Column="1"
							Margin="20,0,20,0"
							VerticalAlignment="Center"
							Spacing="6">
							<TextBlock
								FontSize="26"
								FontWeight="SemiBold"
								Text="{Binding GreetingTitle}"
								TextWrapping="WrapWholeWords" />
							<TextBlock
								FontSize="14"
								Opacity="0.75"
								Text="{Binding GreetingSubtitle}"
								TextWrapping="WrapWholeWords" />
						</StackPanel>

						<Button
							Grid.Column="2"
							VerticalAlignment="Center"
							MinWidth="120"
							Style="{ThemeResource AccentButtonStyle}"
							Command="{Binding SignInCommand}"
							Content="Sign in" />
					</Grid>
				</Border>

				<controls:LeaderboardControl />
				<controls:ExploreTimelapsesControl />
			</StackPanel>
		</ScrollViewer>

		<!-- footer: compact pill on web; full credit line on desktop. -->
		<Grid Grid.Row="1" Margin="24,0,24,12">
			<Border
				Padding="10,4"
				HorizontalAlignment="Center"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="99"
				Visibility="{Binding IsWebPlatform, Converter={StaticResource BoolToVisibilityConverter}}">
				<TextBlock FontSize="12" Opacity="0.75" Text="{Binding WebFooterText}" />
			</Border>

			<TextBlock
				Margin="0,8,0,0"
				HorizontalAlignment="Center"
				FontSize="12"
				Opacity="0.75"
				Text="{Binding FooterText}"
				TextAlignment="Center"
				TextWrapping="Wrap"
				Visibility="{Binding IsWebPlatform, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
		</Grid>
	</Grid>
</Page>
