<UserControl
	x:Class="Riverside.Elapsed.App.Views.Shell"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="300"
	d:DesignWidth="400"
	mc:Ignorable="d"
	Background="{ThemeResource ElapsedPageBackground}">
	<Grid>
		<Grid.RowDefinitions>
			<!-- app navigation bar (desktop only; browser hides this row, its host provides chrome) -->
			<RowDefinition Height="Auto" />
			<!-- navigation host -->
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- compact navigation bar shown on desktop platforms below the native window title bar.
		     hidden on browser (IsDesktopChromeVisible = false) since the browser provides all chrome. -->
		<Grid
			x:Name="AppTitleBar"
			Grid.Row="0"
			Height="52"
			Padding="10,0,12,0"
			Background="{ThemeResource ElapsedSurface}"
			BorderBrush="{ThemeResource ElapsedDivider}"
			BorderThickness="0,0,0,1"
			Visibility="{Binding IsDesktopChromeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!-- left: back + brand wordmark with hack-club-red badge + hamburger menu -->
			<StackPanel
				Grid.Column="0"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="2">
				<Button
					Style="{StaticResource ElapsedIconButton}"
					Command="{Binding BackCommand}"
					ToolTipService.ToolTip="Back">
					<FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Glyph="&#xE72B;" Foreground="{ThemeResource ElapsedTextSecondary}" />
				</Button>
				<Button
					Margin="6,0,2,0"
					Padding="8,6"
					Background="Transparent"
					BorderThickness="0"
					CornerRadius="8"
					Command="{Binding OpenHomeCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<!-- hack-club-red square brandmark -->
						<Border Width="22" Height="22" Background="{ThemeResource ElapsedAccent}" CornerRadius="6">
							<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="E" />
						</Border>
						<TextBlock FontSize="15.5" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="Elapsed" VerticalAlignment="Center" />
						<Border
							Padding="7,2"
							Background="{ThemeResource ElapsedAccentMuted}"
							CornerRadius="999"
							VerticalAlignment="Center"
							Visibility="{Binding HasBrandingSecondary, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedAccent}" Text="{Binding BrandingSecondary}" VerticalAlignment="Center" />
						</Border>
					</StackPanel>
				</Button>
				<Button
					Margin="4,0,0,0"
					Style="{StaticResource ElapsedIconButton}"
					ToolTipService.ToolTip="Menu">
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedLeft">
							<MenuFlyoutItem Command="{Binding OpenHomeCommand}" Text="Home">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE10F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem
								Command="{Binding OpenMyProfileCommand}"
								Text="My profile"
								Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE77B;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}" />
							<MenuFlyoutItem
								Command="{Binding LogoutCommand}"
								Text="Sign out"
								Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xF3B1;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
					<FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Glyph="&#xE700;" Foreground="{ThemeResource ElapsedTextSecondary}" />
				</Button>
			</StackPanel>

			<!-- centre: rounded pill search -->
			<Border
				Grid.Column="1"
				Width="380"
				Height="34"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Background="{ThemeResource ElapsedSurfaceMuted}"
				BorderBrush="{ThemeResource ElapsedStroke}"
				BorderThickness="1"
				CornerRadius="999">
				<Grid Padding="14,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<FontIcon
						Grid.Column="0"
						Margin="0,0,8,0"
						FontSize="13"
						Glyph="&#xE721;"
						Foreground="{ThemeResource ElapsedTextMuted}"
						VerticalAlignment="Center" />
					<TextBox
						Grid.Column="1"
						Background="Transparent"
						BorderThickness="0"
						FontSize="13"
						Foreground="{ThemeResource ElapsedTextPrimary}"
						PlaceholderText="Search timelapses, users, projects"
						Text="{Binding SearchText, Mode=TwoWay}"
						VerticalAlignment="Center" />
				</Grid>
			</Border>

			<!-- right: new recording split button (authenticated) or sign-in button -->
			<StackPanel
				Grid.Column="2"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="10">
				<SplitButton
					Command="{Binding OpenRecordingCommand}"
					Background="{ThemeResource ElapsedAccent}"
					Foreground="White"
					BorderThickness="0"
					CornerRadius="8"
					Padding="12,6"
					ToolTipService.ToolTip="Start a new timelapse session"
					Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon FontSize="13" Glyph="&#xE7C8;" />
						<TextBlock Text="New session" />
					</StackPanel>
					<SplitButton.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuFlyoutItem Command="{Binding OpenRecordingCommand}" Text="Record display">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE7F4;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem Command="{Binding RecordRegionCommand}" Text="Record region">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xEF20;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Command="{Binding UploadExistingCommand}" Text="Upload existing">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE898;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</SplitButton.Flyout>
				</SplitButton>

				<!-- avatar button (authenticated) -->
				<Button
					Width="36"
					Height="36"
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					CornerRadius="999"
					ToolTipService.ToolTip="Account"
					Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuFlyoutItem Command="{Binding OpenMyProfileCommand}" Text="My profile">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE77B;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Command="{Binding LogoutCommand}" Text="Sign out">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xF3B1;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
					<Grid>
						<Ellipse Width="34" Height="34" Fill="{ThemeResource ElapsedAccent}" />
						<Ellipse Width="34" Height="34" Stroke="{ThemeResource ElapsedStroke}" StrokeThickness="1">
							<Ellipse.Fill>
								<ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
							</Ellipse.Fill>
						</Ellipse>
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="12"
							FontWeight="SemiBold"
							Foreground="White"
							IsHitTestVisible="False"
							Text="{Binding AvatarInitials}" />
					</Grid>
				</Button>

				<!-- sign-in button (unauthenticated) -->
				<Button
					Style="{StaticResource ElapsedAccentButton}"
					Command="{Binding SignInCommand}"
					Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon FontSize="13" Glyph="&#xE77B;" Foreground="White" />
						<TextBlock Text="Sign in" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<!-- navigation host. uno.extensions fills Splash.Content with the active page. -->
		<ContentControl
			x:Name="Splash"
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch" />
	</Grid>
</UserControl>
