<Page
	x:Class="Riverside.Elapsed.App.Views.UserProfilePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:utu="using:Uno.Toolkit.UI"
	xmlns:converters="using:Riverside.Elapsed.App.Converters"
	Background="{ThemeResource ElapsedPageBackground}">
	<Grid x:Name="ProfileRoot" utu:SafeArea.Insets="VisibleBounds">
		<ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
			<Grid HorizontalAlignment="Stretch" Padding="0,0,0,40">
				<StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Spacing="0">

					<!-- hero band: subtle accent-tinted background behind the profile card. -->
					<Grid Padding="32,16,32,0">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Style="{StaticResource ElapsedIconButton}" Command="{Binding BackCommand}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<FontIcon FontSize="14" Glyph="&#xE72B;" Foreground="{ThemeResource ElapsedTextSecondary}" />
									<TextBlock FontSize="13" Foreground="{ThemeResource ElapsedTextSecondary}" Text="Back" />
								</StackPanel>
							</Button>
						</StackPanel>
					</Grid>

					<Border Margin="32,12,32,0" Height="120" Background="{ThemeResource ElapsedAccentMuted}" CornerRadius="14,14,0,0" />

					<!-- profile card overlaps the hero band. avatar floats up over the band. -->
					<Border
						Margin="32,-72,32,0"
						Style="{StaticResource ElapsedCard}"
						Padding="28">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<!-- avatar with thick surface ring so it pops off the accent band. -->
							<Grid Width="148" Height="148" Margin="0,-46,0,0" VerticalAlignment="Top">
								<Ellipse Width="148" Height="148" Fill="{ThemeResource ElapsedSurface}" />
								<Ellipse Width="140" Height="140" Stroke="{ThemeResource ElapsedStroke}" StrokeThickness="1">
									<Ellipse.Fill>
										<ImageBrush ImageSource="{Binding ProfilePictureUrl}" Stretch="UniformToFill" />
									</Ellipse.Fill>
								</Ellipse>
							</Grid>

							<StackPanel Grid.Column="1" Margin="22,0,0,0" Spacing="4" VerticalAlignment="Center">
								<TextBlock
									FontSize="34"
									FontWeight="SemiBold"
									Foreground="{ThemeResource ElapsedTextPrimary}"
									Text="{Binding DisplayName}"
									TextWrapping="WrapWholeWords" />
								<TextBlock
									FontSize="15"
									Foreground="{ThemeResource ElapsedTextMuted}"
									Text="{Binding HandleText}" />
								<TextBlock
									Margin="0,10,0,0"
									FontSize="14"
									Foreground="{ThemeResource ElapsedTextSecondary}"
									Text="{Binding Bio}"
									TextWrapping="WrapWholeWords" />
								<StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<FontIcon FontSize="12" Glyph="&#xE787;" Foreground="{ThemeResource ElapsedTextMuted}" />
										<TextBlock FontSize="12" Foreground="{ThemeResource ElapsedTextMuted}" Text="{Binding JoinedText}" />
									</StackPanel>
									<HyperlinkButton
										Padding="0"
										FontSize="12"
										Foreground="{ThemeResource ElapsedAccent}"
										Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisibilityConverter}}"
										Command="{Binding OpenWebsiteCommand}"
										Content="{Binding PrimaryWebsiteText}" />
								</StackPanel>
							</StackPanel>

							<!-- action column. open in lapse web is the primary cta (accent). -->
							<StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" MinWidth="220">
								<Button
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									Style="{StaticResource ElapsedAccentButton}"
									Command="{Binding OpenWebCommand}">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<FontIcon FontSize="13" Glyph="&#xE8A7;" Foreground="White" />
										<TextBlock Foreground="White" Text="Open in Lapse" />
									</StackPanel>
								</Button>
								<Button
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									Style="{StaticResource ElapsedSecondaryButton}"
									Command="{Binding OpenHackatimeCommand}"
									Content="View Hackatime" />
								<Button
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									Style="{StaticResource ElapsedSecondaryButton}"
									Command="{Binding OpenSlackCommand}"
									Content="Message in Slack" />
							</StackPanel>
						</Grid>
					</Border>

					<!-- timelapses section. -->
					<StackPanel Margin="32,28,32,0" Spacing="4">
						<TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="Timelapses" />
						<TextBlock FontSize="13" Foreground="{ThemeResource ElapsedTextMuted}" Text="All public timelapses recorded by this user." />
					</StackPanel>

					<ItemsRepeater Margin="32,16,32,0" ItemsSource="{Binding Timelapses}">
						<ItemsRepeater.Layout>
							<UniformGridLayout MinItemWidth="300" MinItemHeight="260" MinRowSpacing="18" MinColumnSpacing="18" ItemsStretch="Fill" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<Button
									Padding="0"
									Background="Transparent"
									BorderThickness="0"
									CornerRadius="12"
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Stretch"
									Command="{Binding DataContext.OpenTimelapseCommand, ElementName=ProfileRoot}"
									CommandParameter="{Binding}">
									<StackPanel Spacing="10">
										<Border Height="170" Background="{ThemeResource ElapsedThumbnailBackground}" CornerRadius="{ThemeResource ElapsedRadiusThumbnail}">
											<Image Stretch="UniformToFill" Source="{Binding ThumbnailUrl}" />
										</Border>
										<StackPanel Margin="4,0,4,2" Spacing="4">
											<TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="{Binding Title}" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" />
											<TextBlock FontSize="12" Foreground="{ThemeResource ElapsedTextMuted}" Text="{Binding MetaText}" />
										</StackPanel>
									</StackPanel>
								</Button>
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</Page>
