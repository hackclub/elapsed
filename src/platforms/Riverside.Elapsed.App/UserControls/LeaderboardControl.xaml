<UserControl
	x:Class="Riverside.Elapsed.App.UserControls.LeaderboardControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border
		x:Name="LeaderboardRoot"
		Padding="20"
		Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		CornerRadius="12">
		<StackPanel Spacing="14">
			<StackPanel Orientation="Horizontal" Spacing="12">
				<Image Width="40" Height="40" Source="ms-appx:///Assets/Illustrations/orpheus-woah.png" />
				<StackPanel VerticalAlignment="Center">
					<TextBlock FontSize="22" FontWeight="SemiBold" Text="Leaderboard" />
					<TextBlock FontSize="13" Opacity="0.7" Text="These Hack Clubbers spent the most time documenting their work!" />
				</StackPanel>
			</StackPanel>

			<ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
				<ItemsRepeater ItemsSource="{Binding LeaderboardEntries}">
					<ItemsRepeater.Layout>
						<StackLayout Orientation="Horizontal" Spacing="20" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Button
								Padding="0"
								Background="Transparent"
								BorderThickness="0"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								Command="{Binding DataContext.OpenProfileCommand, ElementName=LeaderboardRoot}"
								CommandParameter="{Binding}">
								<StackPanel Width="140" Spacing="6">
									<Ellipse Width="84" Height="84" HorizontalAlignment="Center">
										<Ellipse.Fill>
											<ImageBrush ImageSource="{Binding ProfilePictureUrl}" Stretch="UniformToFill" />
										</Ellipse.Fill>
									</Ellipse>
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="18"
										FontWeight="SemiBold"
										Text="{Binding Name}"
										TextAlignment="Center"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="12"
										Opacity="0.7"
										Text="{Binding WeeklyText}"
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</StackPanel>
	</Border>
</UserControl>
