<Page
	x:Class="Riverside.Elapsed.App.Views.VideoPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:utu="using:Uno.Toolkit.UI"
	Background="{ThemeResource ElapsedPageBackground}">
	<Grid x:Name="VideoRoot" utu:SafeArea.Insets="VisibleBounds">
		<ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
			<Grid HorizontalAlignment="Stretch" Padding="32,16,32,40">
				<Grid MaxWidth="1280" HorizontalAlignment="Stretch">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="380" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!-- back row spans both columns. -->
					<StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16" Orientation="Horizontal" Spacing="8">
						<Button Style="{StaticResource ElapsedIconButton}" Command="{Binding BackCommand}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<FontIcon FontSize="14" Glyph="&#xE72B;" Foreground="{ThemeResource ElapsedTextSecondary}" />
								<TextBlock FontSize="13" Foreground="{ThemeResource ElapsedTextSecondary}" Text="Back" />
							</StackPanel>
						</Button>
					</StackPanel>

					<!-- left: cinematic player + metadata + comments. -->
					<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" Spacing="18">
						<!-- player. flat black bezel, big rounded corners. -->
						<Border Background="#000000" CornerRadius="{ThemeResource ElapsedRadiusThumbnail}">
							<MediaPlayerElement
								MinHeight="420"
								AreTransportControlsEnabled="True"
								AutoPlay="False"
								Source="{Binding PlaybackUrl}" />
						</Border>

						<!-- title + author row. -->
						<StackPanel Spacing="8">
							<TextBlock
								FontSize="28"
								FontWeight="SemiBold"
								Foreground="{ThemeResource ElapsedTextPrimary}"
								Text="{Binding Title}"
								TextWrapping="WrapWholeWords" />
							<Button
								Padding="0"
								Background="Transparent"
								BorderThickness="0"
								HorizontalAlignment="Left"
								Command="{Binding OpenOwnerCommand}">
								<TextBlock FontSize="14" Foreground="{ThemeResource ElapsedAccent}" Text="{Binding Subtitle}" />
							</Button>
						</StackPanel>

						<!-- description in a subtle muted card so it reads as standalone copy. -->
						<Border
							Padding="16"
							Background="{ThemeResource ElapsedSurfaceMuted}"
							BorderBrush="{ThemeResource ElapsedStroke}"
							BorderThickness="1"
							CornerRadius="10">
							<TextBlock
								FontSize="14"
								LineHeight="22"
								Foreground="{ThemeResource ElapsedTextSecondary}"
								Text="{Binding Description}"
								TextWrapping="WrapWholeWords" />
						</Border>

						<!-- comments. -->
						<TextBlock
							Margin="0,8,0,0"
							FontSize="18"
							FontWeight="SemiBold"
							Foreground="{ThemeResource ElapsedTextPrimary}"
							Text="{Binding CommentsHeader}" />

						<!-- compose row in a pill-shaped input. -->
						<Border
							Padding="6,6,6,6"
							Background="{ThemeResource ElapsedSurface}"
							BorderBrush="{ThemeResource ElapsedStroke}"
							BorderThickness="1"
							CornerRadius="12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox
									Grid.Column="0"
									Padding="10,8"
									Background="Transparent"
									BorderThickness="0"
									FontSize="14"
									Foreground="{ThemeResource ElapsedTextPrimary}"
									PlaceholderText="Leave a comment..."
									Text="{Binding NewCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<Button
									Grid.Column="1"
									Style="{StaticResource ElapsedAccentButton}"
									Command="{Binding PostCommentCommand}"
									Content="Post" />
							</Grid>
						</Border>

						<!-- comments list. flat (no per-item border), separated by gentle dividers,
						     so threading reads naturally instead of looking like card spam. -->
						<ItemsRepeater ItemsSource="{Binding Comments}">
							<ItemsRepeater.Layout>
								<StackLayout Orientation="Vertical" Spacing="4" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<Grid Padding="4,14,4,14" BorderBrush="{ThemeResource ElapsedDivider}" BorderThickness="0,0,0,1">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Ellipse Width="38" Height="38" VerticalAlignment="Top" Stroke="{ThemeResource ElapsedStroke}" StrokeThickness="1">
											<Ellipse.Fill>
												<ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
											</Ellipse.Fill>
										</Ellipse>
										<StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="{Binding AuthorName}" />
												<TextBlock FontSize="13" Foreground="{ThemeResource ElapsedTextMuted}" Text="{Binding AuthorHandle}" />
												<TextBlock FontSize="13" Foreground="{ThemeResource ElapsedTextMuted}" Text="·" />
												<TextBlock FontSize="13" Foreground="{ThemeResource ElapsedTextMuted}" Text="{Binding PostedAgo}" />
											</StackPanel>
											<TextBlock FontSize="14" LineHeight="20" Foreground="{ThemeResource ElapsedTextSecondary}" Text="{Binding Body}" TextWrapping="WrapWholeWords" />
										</StackPanel>
									</Grid>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</StackPanel>

					<!-- right rail: more timelapses. -->
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Style="{StaticResource ElapsedCard}"
						Padding="18"
						VerticalAlignment="Top">
						<StackPanel Spacing="14">
							<StackPanel Spacing="2">
								<TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="More timelapses" />
								<TextBlock FontSize="12" Foreground="{ThemeResource ElapsedTextMuted}" Text="Fresh from the rest of the community." />
							</StackPanel>
							<ItemsRepeater ItemsSource="{Binding RelatedTimelapses}">
								<ItemsRepeater.Layout>
									<StackLayout Orientation="Vertical" Spacing="12" />
								</ItemsRepeater.Layout>
								<ItemsRepeater.ItemTemplate>
									<DataTemplate>
										<Button
											Padding="4"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Stretch"
											Background="Transparent"
											BorderThickness="0"
											CornerRadius="10"
											Command="{Binding DataContext.OpenTimelapseCommand, ElementName=VideoRoot}"
											CommandParameter="{Binding}">
											<Grid ColumnSpacing="12">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<Border Width="132" Height="76" Background="{ThemeResource ElapsedThumbnailBackground}" CornerRadius="8">
													<Image Stretch="UniformToFill" Source="{Binding ThumbnailUrl}" />
												</Border>
												<StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
													<TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="{Binding Title}" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" MaxLines="2" />
													<TextBlock FontSize="11" Foreground="{ThemeResource ElapsedTextSecondary}" Text="{Binding OwnerText}" TextTrimming="CharacterEllipsis" />
													<TextBlock FontSize="11" Foreground="{ThemeResource ElapsedTextMuted}" Text="{Binding MetaText}" TextTrimming="CharacterEllipsis" />
												</StackPanel>
											</Grid>
										</Button>
									</DataTemplate>
								</ItemsRepeater.ItemTemplate>
							</ItemsRepeater>
						</StackPanel>
					</Border>
				</Grid>
			</Grid>
		</ScrollViewer>
	</Grid>
</Page>
