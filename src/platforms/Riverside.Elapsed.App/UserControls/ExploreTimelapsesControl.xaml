<UserControl
	x:Class="Riverside.Elapsed.App.UserControls.ExploreTimelapsesControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border
		x:Name="ExploreRoot"
		Padding="20"
		Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		CornerRadius="12">
		<StackPanel Spacing="14">
			<StackPanel Orientation="Horizontal" Spacing="12">
				<Image Width="40" Height="40" Source="ms-appx:///Assets/Illustrations/orpheus-cool.png" />
				<StackPanel VerticalAlignment="Center">
					<TextBlock FontSize="22" FontWeight="SemiBold" Text="Timelapses being created now" />
					<TextBlock FontSize="13" Opacity="0.7" Text="See what other Hack Clubbers are up to!" />
				</StackPanel>
			</StackPanel>

			<ItemsRepeater ItemsSource="{Binding ExploreTimelapses}">
				<ItemsRepeater.Layout>
					<UniformGridLayout MinItemWidth="320" MinItemHeight="260" MinColumnSpacing="14" MinRowSpacing="14" ItemsStretch="Fill" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate>
						<Button
							Padding="0"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Stretch"
							Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="10"
							Command="{Binding DataContext.OpenTimelapseCommand, ElementName=ExploreRoot}"
							CommandParameter="{Binding}">
							<StackPanel Spacing="6">
								<Image Height="170" Stretch="UniformToFill" Source="{Binding ThumbnailUrl}" />
								<StackPanel Margin="12,4,12,12" Spacing="2">
									<TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="WrapWholeWords" />
									<TextBlock FontSize="12" Opacity="0.75" Text="{Binding OwnerText}" />
									<TextBlock FontSize="12" Opacity="0.6" Text="{Binding MetaText}" />
								</StackPanel>
							</StackPanel>
						</Button>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</StackPanel>
	</Border>
</UserControl>
