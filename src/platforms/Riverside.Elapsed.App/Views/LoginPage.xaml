<Page
	x:Class="Riverside.Elapsed.App.Views.LoginPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:utu="using:Uno.Toolkit.UI"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	NavigationCacheMode="Required">
	<Grid utu:SafeArea.Insets="VisibleBounds">
		<Border
			MaxWidth="480"
			Padding="32"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="16">
			<StackPanel Spacing="16">
				<Image
					Width="100"
					Height="100"
					HorizontalAlignment="Center"
					Source="ms-appx:///Assets/Illustrations/orpheus-time.png" />

				<TextBlock
					HorizontalAlignment="Center"
					FontSize="24"
					FontWeight="SemiBold"
					Text="{Binding Title}" />

				<TextBlock
					HorizontalAlignment="Center"
					FontSize="14"
					Opacity="0.7"
					Text="{Binding Description}"
					TextAlignment="Center"
					TextWrapping="Wrap" />

				<Button
					MinWidth="200"
					HorizontalAlignment="Center"
					Command="{Binding LoginCommand}"
					IsEnabled="{Binding IsLoginSupported}"
					Style="{ThemeResource AccentButtonStyle}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon FontSize="14" Glyph="&#xE77B;" />
						<TextBlock Text="Sign in with Lapse" />
					</StackPanel>
				</Button>

				<!-- shown when sign-in is unavailable (e.g. wasm preview) or when an error occurs -->
				<Border
					Padding="12"
					Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
					CornerRadius="8"
					Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock
						FontSize="13"
						Foreground="{ThemeResource SystemFillColorCriticalBrush}"
						Text="{Binding Message}"
						TextAlignment="Center"
						TextWrapping="Wrap" />
				</Border>
			</StackPanel>
		</Border>
	</Grid>
</Page>
