<Page
	x:Class="Riverside.Elapsed.App.Views.UserProfilePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:utu="using:Uno.Toolkit.UI"
	xmlns:converters="using:Riverside.Elapsed.App.Converters"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
	<Grid x:Name="ProfileRoot" utu:SafeArea.Insets="VisibleBounds">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- back row -->
		<StackPanel Margin="24,16,24,0" Orientation="Horizontal" Spacing="8">
			<Button Command="{Binding BackCommand}" Background="Transparent" Padding="8,4">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<FontIcon FontSize="14" Glyph="&#xE72B;" />
					<TextBlock Text="Back" />
				</StackPanel>
			</Button>
		</StackPanel>

		<ScrollViewer Grid.Row="1" Padding="24,12,24,24">
			<StackPanel Spacing="20">
				<!-- profile header -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Ellipse Width="140" Height="140" VerticalAlignment="Top">
						<Ellipse.Fill>
							<ImageBrush ImageSource="{Binding ProfilePictureUrl}" Stretch="UniformToFill" />
						</Ellipse.Fill>
					</Ellipse>

					<StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6" VerticalAlignment="Top">
						<TextBlock FontSize="36" FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="WrapWholeWords" />
						<TextBlock FontSize="16" Opacity="0.7" Text="{Binding HandleText}" />
						<TextBlock FontSize="14" Text="{Binding Bio}" TextWrapping="WrapWholeWords" Margin="0,8,0,0" />
						<TextBlock FontSize="13" Opacity="0.65" Text="{Binding JoinedText}" Margin="0,8,0,0" />
						<HyperlinkButton
							Padding="0"
							Margin="0,4,0,0"
							Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisibilityConverter}}"
							Command="{Binding OpenWebsiteCommand}"
							Content="{Binding PrimaryWebsiteText}" />
					</StackPanel>

					<StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top" MinWidth="240">
						<Button HorizontalAlignment="Stretch" Command="{Binding OpenWebCommand}" Content="Open in Lapse for web" />
						<Button HorizontalAlignment="Stretch" Command="{Binding OpenHackatimeCommand}" Content="Open in Hackatime" />
						<Button HorizontalAlignment="Stretch" Command="{Binding OpenSlackCommand}" Content="Open in Slack" />
					</StackPanel>
				</Grid>

				<!-- timelapses grid -->
				<TextBlock FontSize="22" FontWeight="SemiBold" Text="Timelapses" />
				<ItemsRepeater ItemsSource="{Binding Timelapses}">
					<ItemsRepeater.Layout>
						<UniformGridLayout MinItemWidth="300" MinItemHeight="240" MinRowSpacing="14" MinColumnSpacing="14" ItemsStretch="Fill" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Button
								Padding="0"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="8"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Stretch"
								Command="{Binding DataContext.OpenTimelapseCommand, ElementName=ProfileRoot}"
								CommandParameter="{Binding}">
								<StackPanel Spacing="6">
									<Image Height="160" Stretch="UniformToFill" Source="{Binding ThumbnailUrl}" />
									<StackPanel Margin="10,4,10,12" Spacing="2">
										<TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="WrapWholeWords" />
										<TextBlock FontSize="12" Opacity="0.7" Text="{Binding MetaText}" />
									</StackPanel>
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
