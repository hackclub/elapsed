<Page
	x:Class="Riverside.Elapsed.App.Views.RecordingPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<!-- Setup / controls panel (always visible) -->
		<Border
			Grid.Column="0"
			Width="340"
			Padding="20"
			Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
			<Grid>
				<!-- Setup state -->
				<StackPanel
					Spacing="16"
					Visibility="{Binding IsInSetup, Converter={StaticResource BoolToVisibilityConverter}}">

					<!-- Header: brand + settings -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel
							Grid.Column="0"
							Orientation="Horizontal"
							Spacing="8"
							VerticalAlignment="Center">
							<Ellipse
								Width="28"
								Height="28"
								Stroke="{ThemeResource AccentFillColorDefaultBrush}"
								StrokeThickness="3" />
							<TextBlock
								FontSize="18"
								FontWeight="SemiBold"
								VerticalAlignment="Center"
								Text="Elapsed" />
						</StackPanel>
						<Button
							Grid.Column="1"
							Width="32"
							Height="32"
							Padding="0"
							Background="Transparent"
							BorderThickness="0"
							ToolTipService.ToolTip="Settings">
							<FontIcon FontSize="16" Glyph="&#xE713;" />
						</Button>
					</Grid>

					<!-- Source kind toggle: Screen / Window -->
					<Grid
						Height="36"
						Background="{ThemeResource ControlFillColorSecondaryBrush}"
						CornerRadius="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<RadioButton
							x:Name="ScreenRadio"
							Grid.Column="0"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Screen"
							GroupName="SourceKind"
							IsChecked="True"
							Style="{StaticResource SegmentedToggleStyle}" />
						<RadioButton
							x:Name="WindowRadio"
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Content="Window"
							GroupName="SourceKind"
							Style="{StaticResource SegmentedToggleStyle}" />
					</Grid>

					<!-- Camera selector -->
					<StackPanel Spacing="4">
						<TextBlock
							FontSize="12"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Camera" />
						<Border
							Padding="12,10"
							Background="{ThemeResource ControlFillColorDefaultBrush}"
							BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<FontIcon
									Grid.Column="0"
									Margin="0,0,10,0"
									FontSize="16"
									Glyph="&#xE714;"
									Opacity="0.6"
									VerticalAlignment="Center" />
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding SelectedCamera.Name, FallbackValue='No Camera'}"
									TextTrimming="CharacterEllipsis" />
								<Button
									Grid.Column="2"
									MinWidth="0"
									Padding="8,4"
									Background="Transparent"
									BorderThickness="0"
									Command="{Binding ToggleCameraCommand}"
									FontSize="12"
									FontWeight="SemiBold"
									Foreground="{Binding IsCameraEnabled, Converter={StaticResource BoolToToggleColorConverter}}"
									Content="{Binding CameraToggleLabel}" />
							</Grid>
						</Border>
					</StackPanel>

					<!-- Microphone selector -->
					<StackPanel Spacing="4">
						<TextBlock
							FontSize="12"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Microphone" />
						<Border
							Padding="12,10"
							Background="{ThemeResource ControlFillColorDefaultBrush}"
							BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<FontIcon
									Grid.Column="0"
									Margin="0,0,10,0"
									FontSize="16"
									Glyph="&#xE720;"
									Opacity="0.6"
									VerticalAlignment="Center" />
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding SelectedMicrophone.Name, FallbackValue='No Audio'}"
									TextTrimming="CharacterEllipsis" />
								<Button
									Grid.Column="2"
									MinWidth="0"
									Padding="8,4"
									Background="Transparent"
									BorderThickness="0"
									Command="{Binding ToggleMicrophoneCommand}"
									FontSize="12"
									FontWeight="SemiBold"
									Foreground="{Binding IsMicrophoneEnabled, Converter={StaticResource BoolToToggleColorConverter}}"
									Content="{Binding MicrophoneToggleLabel}" />
							</Grid>
						</Border>
					</StackPanel>

					<!-- Start recording button -->
					<Button
						Height="44"
						HorizontalAlignment="Stretch"
						Command="{Binding StartRecordingCommand}"
						CornerRadius="22"
						Style="{ThemeResource AccentButtonStyle}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon FontSize="14" Glyph="&#xE7C8;" />
							<TextBlock
								FontSize="14"
								FontWeight="SemiBold"
								Text="Start Recording"
								VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<!-- Open on web link -->
					<HyperlinkButton
						HorizontalAlignment="Center"
						Content="Open Elapsed on Web"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						FontSize="12"
						NavigateUri="https://lapse.hackclub.com" />
				</StackPanel>

				<!-- Active recording state -->
				<StackPanel
					Spacing="16"
					VerticalAlignment="Center"
					Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">

					<!-- Recording indicator -->
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="8">
						<Ellipse
							Width="10"
							Height="10"
							VerticalAlignment="Center"
							Fill="Red" />
						<TextBlock
							FontSize="14"
							FontWeight="SemiBold"
							VerticalAlignment="Center"
							Text="{Binding IsPaused, Converter={StaticResource BoolToPausedRecordingLabelConverter}}" />
					</StackPanel>

					<!-- Elapsed time -->
					<TextBlock
						FontSize="48"
						FontWeight="SemiBold"
						HorizontalAlignment="Center"
						Text="{Binding ElapsedDisplay}" />

					<!-- Controls -->
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="12">
						<Button
							Width="48"
							Height="48"
							Padding="0"
							Command="{Binding PauseResumeCommand}"
							CornerRadius="24"
							ToolTipService.ToolTip="{Binding PauseResumeLabel}">
							<FontIcon FontSize="18" Glyph="{Binding PauseResumeGlyph}" />
						</Button>
						<Button
							Width="48"
							Height="48"
							Padding="0"
							Command="{Binding StopCommand}"
							CornerRadius="24"
							Style="{ThemeResource AccentButtonStyle}"
							ToolTipService.ToolTip="Stop recording">
							<FontIcon FontSize="16" Glyph="&#xE71A;" />
						</Button>
					</StackPanel>

					<!-- Status -->
					<TextBlock
						FontSize="12"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						HorizontalAlignment="Center"
						Text="{Binding StatusMessage}"
						TextWrapping="Wrap"
						Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
				</StackPanel>
			</Grid>
		</Border>

		<!-- Preview panel (visible only during recording) -->
		<Border
			Grid.Column="1"
			Width="460"
			Background="{ThemeResource ControlFillColorSecondaryBrush}"
			BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
			BorderThickness="1,0,0,0"
			Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
			<Grid>
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}"
					Text="Preview" />
			</Grid>
		</Border>
	</Grid>
</Page>
