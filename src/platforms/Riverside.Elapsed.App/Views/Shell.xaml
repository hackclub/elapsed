<UserControl
	x:Class="Riverside.Elapsed.App.Views.Shell"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="300"
	d:DesignWidth="400"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<!-- app navigation bar (desktop only; browser hides this row, its host provides chrome) -->
			<RowDefinition Height="Auto" />
			<!-- navigation host -->
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--
			compact navigation bar shown on desktop platforms below the native window title bar.
			hidden on browser (IsDesktopChromeVisible = false) since the browser provides all chrome.
		-->
		<Grid
			x:Name="AppTitleBar"
			Grid.Row="0"
			Height="44"
			Padding="4,0,8,0"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!-- left: back + hamburger menu + wordmark -->
			<StackPanel
				Grid.Column="0"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="0">
				<Button
					Padding="10,8"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding BackCommand}"
					ToolTipService.ToolTip="Back">
					<FontIcon
						FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
						FontSize="13"
						Glyph="&#xE72B;" />
				</Button>
				<Button
					Padding="10,8"
					Background="Transparent"
					BorderThickness="0"
					ToolTipService.ToolTip="Menu">
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedLeft">
							<MenuFlyoutItem Command="{Binding OpenHomeCommand}" Text="Home">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE10F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem
								Command="{Binding OpenMyProfileCommand}"
								Text="My profile"
								Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE77B;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}" />
							<MenuFlyoutItem
								Command="{Binding LogoutCommand}"
								Text="Sign out"
								Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xF3B1;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
					<FontIcon
						FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
						FontSize="15"
						Glyph="&#xE700;" />
				</Button>
				<Button
					Margin="4,0,0,0"
					Padding="6,4"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding OpenHomeCommand}">
					<StackPanel
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Spacing="5">
						<TextBlock
							VerticalAlignment="Center"
							FontSize="15"
							FontWeight="SemiBold"
							Text="Elapsed" />
						<Border
							Padding="5,1"
							Background="{ThemeResource AccentFillColorDefaultBrush}"
							CornerRadius="4"
							Visibility="{Binding HasBrandingSecondary, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock
								VerticalAlignment="Center"
								FontSize="11"
								FontWeight="SemiBold"
								Foreground="White"
								Text="{Binding BrandingSecondary}" />
						</Border>
					</StackPanel>
				</Button>
			</StackPanel>

			<!-- centre: search -->
			<Border
				Grid.Column="1"
				Width="340"
				Height="28"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Background="{ThemeResource TextControlBackground}"
				BorderBrush="{ThemeResource TextControlBorderBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<Grid Padding="8,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<FontIcon
						Grid.Column="0"
						Margin="0,0,6,0"
						VerticalAlignment="Center"
						FontSize="13"
						Glyph="&#xE721;"
						Opacity="0.55" />
					<TextBox
						Grid.Column="1"
						VerticalAlignment="Center"
						Background="Transparent"
						BorderThickness="0"
						FontSize="13"
						PlaceholderText="Search"
						Text="{Binding SearchText, Mode=TwoWay}" />
				</Grid>
			</Border>

			<!-- right: new recording split button (authenticated) or sign-in button -->
			<StackPanel
				Grid.Column="2"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="8">
				<SplitButton
					Command="{Binding OpenRecordingCommand}"
					Style="{ThemeResource AccentSplitButtonStyle}"
					ToolTipService.ToolTip="Start a new timelapse session"
					Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon FontSize="13" Glyph="&#xE7C8;" />
						<TextBlock Text="New session" />
					</StackPanel>
					<SplitButton.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuFlyoutItem Command="{Binding OpenRecordingCommand}" Text="Record display">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE7F4;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem Command="{Binding RecordRegionCommand}" Text="Record region">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xEF20;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Command="{Binding UploadExistingCommand}" Text="Upload existing">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE898;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</SplitButton.Flyout>
				</SplitButton>

				<!-- avatar button (authenticated) -->
				<Button
					Width="32"
					Height="32"
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					ToolTipService.ToolTip="Account"
					Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuFlyoutItem Command="{Binding OpenMyProfileCommand}" Text="My profile">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE77B;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Command="{Binding LogoutCommand}" Text="Sign out">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xF3B1;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
					<Grid>
						<Ellipse
							Width="30"
							Height="30"
							Fill="{ThemeResource AccentFillColorDefaultBrush}" />
						<Ellipse Width="30" Height="30">
							<Ellipse.Fill>
								<ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
							</Ellipse.Fill>
						</Ellipse>
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="11"
							FontWeight="SemiBold"
							Foreground="White"
							IsHitTestVisible="False"
							Text="{Binding AvatarInitials}" />
					</Grid>
				</Button>

				<!-- sign-in button (unauthenticated) -->
				<Button Command="{Binding SignInCommand}" Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon FontSize="13" Glyph="&#xE77B;" />
						<TextBlock Text="Sign in" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<!-- navigation host. uno.extensions fills Splash.Content with the active page. -->
		<ContentControl
			x:Name="Splash"
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch" />
	</Grid>
</UserControl>
