<UserControl
	x:Class="Riverside.Elapsed.App.UserControls.ExploreTimelapsesControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border
		x:Name="ExploreRoot"
		Style="{StaticResource ElapsedCard}">
		<StackPanel Spacing="22">

			<!-- header: excited-orpheus illustration + title + subtitle. -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Image
					Width="60"
					Height="60"
					VerticalAlignment="Center"
					Source="ms-appx:///Assets/Illustrations/orpheus-woah.png" />
				<StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="3">
					<TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ElapsedTextPrimary}" Text="Timelapses being created now" />
					<TextBlock FontSize="13" Foreground="{ThemeResource ElapsedTextMuted}" Text="See what other Hack Clubbers are up to right now." />
				</StackPanel>
			</Grid>

			<!-- responsive thumbnail grid; reflows from 1 to N columns by available width. -->
			<ItemsRepeater ItemsSource="{Binding ExploreTimelapses}">
				<ItemsRepeater.Layout>
					<UniformGridLayout
						MinItemWidth="300"
						MinItemHeight="260"
						MinColumnSpacing="20"
						MinRowSpacing="20"
						ItemsStretch="Fill" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate>
						<Button
							Padding="0"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Stretch"
							Background="Transparent"
							BorderThickness="0"
							CornerRadius="12"
							Command="{Binding DataContext.OpenTimelapseCommand, ElementName=ExploreRoot}"
							CommandParameter="{Binding}">
							<StackPanel Spacing="10">
								<!-- 16:9-ish thumbnail with rounded corners. dark placeholder so the
								     card is visually grounded before the image loads. -->
								<Border
									Height="170"
									Background="{ThemeResource ElapsedThumbnailBackground}"
									CornerRadius="{ThemeResource ElapsedRadiusThumbnail}">
									<Image Stretch="UniformToFill" Source="{Binding ThumbnailUrl}" />
								</Border>
								<StackPanel Spacing="4" Margin="4,0,4,2">
									<TextBlock
										FontSize="15"
										FontWeight="SemiBold"
										Foreground="{ThemeResource ElapsedTextPrimary}"
										Text="{Binding Title}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="WrapWholeWords" />
									<TextBlock
										FontSize="12"
										Foreground="{ThemeResource ElapsedTextSecondary}"
										Text="{Binding OwnerText}"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										FontSize="12"
										Foreground="{ThemeResource ElapsedTextMuted}"
										Text="{Binding MetaText}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</StackPanel>
						</Button>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</StackPanel>
	</Border>
</UserControl>
