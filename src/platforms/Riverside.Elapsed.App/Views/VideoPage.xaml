<Page
	x:Class="Riverside.Elapsed.App.Views.VideoPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:utu="using:Uno.Toolkit.UI"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
	<Grid x:Name="VideoRoot" utu:SafeArea.Insets="VisibleBounds">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="380" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- back row -->
		<StackPanel Grid.ColumnSpan="2" Margin="24,16,24,0" Orientation="Horizontal" Spacing="8">
			<Button Command="{Binding BackCommand}" Background="Transparent" Padding="8,4">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<FontIcon FontSize="14" Glyph="&#xE72B;" />
					<TextBlock Text="Back" />
				</StackPanel>
			</Button>
		</StackPanel>

		<!-- left: player + metadata + comments -->
		<ScrollViewer Grid.Row="1" Padding="24,12,12,24" HorizontalScrollMode="Disabled">
			<StackPanel Spacing="14">
				<Border
					Background="Black"
					CornerRadius="10"
					Padding="0">
					<MediaPlayerElement
						MinHeight="380"
						AreTransportControlsEnabled="True"
						AutoPlay="False"
						Source="{Binding PlaybackUrl}" />
				</Border>

				<TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="WrapWholeWords" />

				<Button
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					HorizontalAlignment="Left"
					Command="{Binding OpenOwnerCommand}">
					<TextBlock FontSize="14" Opacity="0.75" Text="{Binding Subtitle}" />
				</Button>

				<TextBlock FontSize="14" Text="{Binding Description}" TextWrapping="WrapWholeWords" />

				<!-- comments section -->
				<TextBlock
					Margin="0,12,0,0"
					FontSize="18"
					FontWeight="SemiBold"
					Text="{Binding CommentsHeader}" />

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox
						Grid.Column="0"
						PlaceholderText="Add a comment..."
						Text="{Binding NewCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<Button
						Grid.Column="1"
						Margin="8,0,0,0"
						Style="{ThemeResource AccentButtonStyle}"
						Command="{Binding PostCommentCommand}"
						Content="Post" />
				</Grid>

				<ItemsRepeater ItemsSource="{Binding Comments}">
					<ItemsRepeater.Layout>
						<StackLayout Orientation="Vertical" Spacing="10" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Border
								Padding="12"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="10">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Ellipse Width="36" Height="36" VerticalAlignment="Top">
										<Ellipse.Fill>
											<ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
										</Ellipse.Fill>
									</Ellipse>
									<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock FontWeight="SemiBold" Text="{Binding AuthorName}" />
											<TextBlock Opacity="0.6" Text="{Binding AuthorHandle}" />
											<TextBlock Opacity="0.6" Text="·" />
											<TextBlock Opacity="0.6" Text="{Binding PostedAgo}" />
										</StackPanel>
										<TextBlock FontSize="14" Text="{Binding Body}" TextWrapping="WrapWholeWords" />
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</StackPanel>
		</ScrollViewer>

		<!-- right rail: related timelapses -->
		<Border
			Grid.Row="1"
			Grid.Column="1"
			Margin="12,12,24,24"
			Padding="12"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="10">
			<Grid RowSpacing="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock FontSize="16" FontWeight="SemiBold" Text="More timelapses" />
				<ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
					<ItemsRepeater ItemsSource="{Binding RelatedTimelapses}">
						<ItemsRepeater.Layout>
							<StackLayout Orientation="Vertical" Spacing="10" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<Button
									Padding="6"
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Stretch"
									Background="Transparent"
									BorderThickness="0"
									Command="{Binding DataContext.OpenTimelapseCommand, ElementName=VideoRoot}"
									CommandParameter="{Binding}">
									<Grid ColumnSpacing="10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Image Width="128" Height="72" Stretch="UniformToFill" Source="{Binding ThumbnailUrl}" />
										<StackPanel Grid.Column="1" Spacing="2">
											<TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="WrapWholeWords" />
											<TextBlock FontSize="11" Opacity="0.7" Text="{Binding OwnerText}" TextWrapping="WrapWholeWords" />
											<TextBlock FontSize="11" Opacity="0.6" Text="{Binding MetaText}" />
										</StackPanel>
									</Grid>
								</Button>
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</ScrollViewer>
			</Grid>
		</Border>
	</Grid>
</Page>
